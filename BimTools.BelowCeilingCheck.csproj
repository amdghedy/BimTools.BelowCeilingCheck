<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2020</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &lt;= '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BimTools.BelowCeilingCheck</AssemblyName>
    <RootNamespace>BimTools.BelowCeilingCheck</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Company>BIM TOOLS</Company>
    <Product>BIM TOOLS - Below Ceiling Check</Product>
    <Description>MEP coordination tool that reports model elements located below the ceiling.</Description>
    <Copyright>Copyright (c) BIM TOOLS</Copyright>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitInstallDir>
    <AddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinsDir>
    <DebugType>portable</DebugType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BelowCeilingCheck.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Local deployment is opt-in; GitHub Actions must only compile and package. -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(DeployAddin)' == 'true'">
    <MakeDir Directories="$(AddinsDir)BimTools.BelowCeilingCheck" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AddinsDir)BimTools.BelowCeilingCheck" Retries="1" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\BelowCeilingCheck.addin" DestinationFolder="$(AddinsDir)" Retries="1" ContinueOnError="true" />
  </Target>

</Project>
