<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BimTools.BelowCeilingCheck</AssemblyName>
    <RootNamespace>BimTools.BelowCeilingCheck</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Company>BIM TOOLS</Company>
    <Product>BIM TOOLS - Below Ceiling Check</Product>
    <Description>MEP coordination tool that reports model elements located below the ceiling.</Description>
    <Copyright>Copyright (c) BIM TOOLS</Copyright>
    <RevitVersion>2020</RevitVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitInstallDir>
    <AddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinsDir>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BelowCeilingCheck.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copies the DLL and the manifest into the Revit 2020 add-ins folder after every build.
       If Revit is running it keeps the DLL locked: the copy then only warns, so close Revit and rebuild to deploy. -->
  <Target Name="DeployAddin" AfterTargets="Build">
    <MakeDir Directories="$(AddinsDir)BimTools.BelowCeilingCheck" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AddinsDir)BimTools.BelowCeilingCheck" Retries="1" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\BelowCeilingCheck.addin" DestinationFolder="$(AddinsDir)" Retries="1" ContinueOnError="true" />
  </Target>

</Project>
